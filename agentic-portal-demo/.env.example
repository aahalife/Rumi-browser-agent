# Rork AI Cloud is the default. Original anthropic and bedrock adapters remain available.
LLM_PROVIDER=rork
LLM_MODEL=anthropic/claude-sonnet-5.5
# Configure these in the backend host's secret/environment settings, not in source.
EXPO_PUBLIC_TOOLKIT_URL=
EXPO_PUBLIC_RORK_TOOLKIT_SECRET_KEY=
# low | medium | high | xhigh | max. medium keeps the demo snappy.
LLM_EFFORT=medium
ANTHROPIC_API_KEY=
# Only used when LLM_PROVIDER=bedrock (plus the usual AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY / AWS_PROFILE)
AWS_REGION=us-east-1

# dom | screenshot (keep comments on their own line: docker --env-file does not strip them)
PERCEPTION_MODE=dom
MAX_STEPS=30
DEMO_API_KEY=change-me
JWT_SECRET=change-me-to-a-long-random-string
# Use true on the hosted HTTPS demo. Use false only for local HTTP tests.
COOKIE_SECURE=true
RESEED=0
